# Copier ce fichier en .env puis remplacer les valeurs « change-moi ».
# Ne jamais versionner le fichier .env.

# --- Base de données PostgreSQL ---
POSTGRES_USER=hawiya
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=hawiya

# URL utilisées par le backend (hôte « db » = service docker-compose)
DATABASE_URL=postgresql+psycopg://hawiya:change-moi@db:5432/hawiya
TEST_DATABASE_URL=postgresql+psycopg://hawiya:change-moi@db:5432/hawiya_test

# --- Jetons d'accès ---
# Au moins 32 caractères aléatoires, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-moi-change-moi-change-moi-change-moi
JWT_DUREE_MINUTES=60

# --- Service de comparaison (matcher) ---
# Secret partagé backend ↔ matcher (au moins 16 caractères aléatoires).
MATCHER_CLE=change-moi-change-moi
MATCHER_URL=http://matcher:8080

# --- Agent de démonstration créé par le script de données fictives ---
SEED_AGENT_MATRICULE=AG-0001
SEED_AGENT_MOT_DE_PASSE=change-moi
